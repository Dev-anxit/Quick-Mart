# Frontend Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env files to version control!

# ============================================
# REQUIRED VARIABLES
# ============================================

# API Configuration
# Development: http://localhost:3500/api
# Production: https://your-backend.onrender.com/api
VITE_API_BASE_URL=http://localhost:3500/api

# ============================================
# PAYMENT INTEGRATION (Razorpay)
# Get keys from: https://razorpay.com/dashboard
# TEST mode keys start with: rzp_test_
# LIVE mode keys start with: rzp_live_
# ============================================

VITE_RAZORPAY_KEY_ID=rzp_test_xxxxx

# ============================================
# OPTIONAL: Firebase Authentication
# Get from: https://console.firebase.google.com
# These are PUBLIC keys - safe to be in client code
# ============================================

# VITE_FIREBASE_API_KEY=your_firebase_api_key
# VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your_project_id
# VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
# VITE_FIREBASE_APP_ID=your_app_id

# ============================================
# OPTIONAL: Google Maps
# Get from: https://console.cloud.google.com
# ============================================

# VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ============================================
# DEVELOPMENT vs PRODUCTION
# ============================================
# Development:
#   - Use localhost URLs
#   - Use test API keys (rzp_test_*)
#   - Use development Firebase project
#
# Production:
#   - Use production URLs (Vercel, Render, etc.)
#   - Use LIVE API keys (rzp_live_*)
#   - Use production Firebase project
#   - Set in Vercel environment variables, NOT in code
