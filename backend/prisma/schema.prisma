// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// User model for authentication
model User {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  uid           String   @unique
  email         String   @unique
  phone         String   @default("")
  name          String   @default("")
  avatar        String?
  phone_verified Boolean @default(false)
  otp           String?
  otp_expiry    DateTime?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Relations
  addresses     Address[]
  orders        Order[]
  reviews       Review[]

  @@map("users")
}

// Category model
model Category {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String?
  image_url   String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // Relations
  products    Product[]

  @@map("categories")
}

// Product model
model Product {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  description   String?
  price         Float
  discount_percentage Float @default(0)
  stock         Int      @default(0)
  rating        Float    @default(0)
  image_urls    String[] @default([])
  category_id   String   @db.ObjectId
  is_active     Boolean  @default(true)
  veg_nonveg    String   @default("veg")
  weight        String   @default("")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Relations
  category      Category @relation(fields: [category_id], references: [id], onDelete: Cascade)
  order_items   OrderItem[]
  reviews       Review[]

  @@map("products")
}

// Address model
model Address {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  user_id     String   @db.ObjectId
  type        String   // home, work, other
  street      String
  city        String
  state       String
  postal_code String
  latitude    Float
  longitude   Float
  is_default  Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // Relations
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("addresses")
}

// Order model
model Order {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  user_id         String   @db.ObjectId
  order_number    String   @unique
  total_amount    Float
  discount_amount Float    @default(0)
  delivery_fee    Float    @default(50)
  tax_amount      Float    @default(0)
  payment_method  String
  payment_id      String?
  status          String   @default("pending")
  notes           String?
  delivery_address String
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // Relations
  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  items           OrderItem[]
  tracking        OrderTracking?

  @@map("orders")
}

// OrderItem model
model OrderItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  order_id  String   @db.ObjectId
  product_id String  @db.ObjectId
  quantity  Int
  price     Float
  discount  Float    @default(0)

  // Relations
  order     Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [product_id], references: [id], onDelete: Restrict)

  @@map("order_items")
}

// Rider model
model Rider {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  phone           String   @unique
  email           String   @unique
  vehicle_type    String
  license_number  String   @unique
  status          String   @default("offline")
  total_deliveries Int    @default(0)
  rating          Float    @default(0)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // Relations
  locations       RiderLocation[]

  @@map("riders")
}

// RiderLocation model
model RiderLocation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  rider_id  String   @db.ObjectId
  latitude  Float
  longitude Float
  created_at DateTime @default(now())

  // Relations
  rider     Rider    @relation(fields: [rider_id], references: [id], onDelete: Cascade)

  @@map("rider_locations")
}

// OrderTracking model
model OrderTracking {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  order_id  String   @unique @db.ObjectId
  rider_id  String?
  status    String
  latitude  Float?
  longitude Float?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  order     Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@map("order_tracking")
}

// Review model
model Review {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user_id   String   @db.ObjectId
  product_id String  @db.ObjectId
  rating    Int
  comment   String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@map("reviews")
}

// Promo model
model Promo {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  code        String   @unique
  discount_percentage Float
  max_discount Float?
  min_purchase Float?
  usage_limit Int?
  times_used  Int      @default(0)
  is_active   Boolean  @default(true)
  expires_at  DateTime?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("promos")
}
