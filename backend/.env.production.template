# Production Backend Environment Configuration

# Server
NODE_ENV=production
PORT=5000

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/quickmart

# JWT
JWT_SECRET=your-super-secure-random-string-32-chars-minimum-change-this

# Redis (optional)
REDIS_URL=redis://localhost:6379

# Frontend URLs for CORS
FRONTEND_URL=https://quickmart.vercel.app

# Razorpay (optional - for payments)
RAZORPAY_KEY_ID=rzp_live_xxxxx
RAZORPAY_KEY_SECRET=xxxxx

# Firebase Admin SDK (optional - for notifications)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com

# Cloudinary (optional - for image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=xxxxx
CLOUDINARY_API_SECRET=xxxxx

# Admin
ADMIN_USER_UID=your-admin-firebase-uid
